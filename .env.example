# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Application ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DB_PORT=5432
# Only needed when running the API outside Docker (inside Docker, compose sets it):
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
TEST_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_test

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=32
# e5 = real model (downloads ~1 GB once) | fake = instant test vectors, no real meaning
EMBEDDING_PROVIDER=e5

# --- Ingestion ---
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=75

# --- Retrieval / chat ---
RETRIEVAL_TOP_K=5
# vector | fulltext | hybrid (hybrid = vector + full-text fused with RRF)
RETRIEVAL_MODE=vector
HYBRID_CANDIDATES=20
RRF_K=60
CHAT_HISTORY_MESSAGES=6
