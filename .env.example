# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# --- Application ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DB_PORT=5432
# Only needed when running the API outside Docker (inside Docker, compose sets it):
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
TEST_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_test
EVAL_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_eval

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=64000
# low | medium | high | xhigh | max, or empty to use the model default
LLM_EFFORT=medium
# Retry on a fallback model if a safety classifier declines (set false for Haiku models)
LLM_REFUSAL_FALLBACK=true

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=32
# e5 = real model (downloads ~1 GB once) | fake = instant test vectors, no real meaning
EMBEDDING_PROVIDER=e5

# --- Ingestion ---
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=75
# Add the document title to each passage before computing its embedding.
# Changing this (or the chunk sizes) only applies to documents imported afterwards.
EMBED_DOCUMENT_TITLE=true

# --- Retrieval / chat ---
RETRIEVAL_TOP_K=5
# vector | fulltext | hybrid (hybrid = vector + full-text fused with RRF)
RETRIEVAL_MODE=vector
HYBRID_CANDIDATES=20
RRF_K=60
# Reranking with a cross-encoder: more precise, but several seconds per question on CPU.
RERANK_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
CHAT_HISTORY_MESSAGES=6
